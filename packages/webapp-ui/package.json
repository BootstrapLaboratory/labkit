{
  "name": "@omgjs/labkit-webapp-ui",
  "version": "0.0.1",
  "description": "UI framework helpers and contracts for Labkit webapps without concrete product components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BootstrapLaboratory/labkit.git",
    "directory": "packages/webapp-ui"
  },
  "homepage": "https://github.com/BootstrapLaboratory/labkit/tree/main/packages/webapp-ui#readme",
  "bugs": {
    "url": "https://github.com/BootstrapLaboratory/labkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/esm/src/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node ../../common/scripts/write-esm-package-marker.mjs",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run test"
  },
  "dependencies": {
    "@omgjs/labkit-webapp-external-store": "0.0.1"
  },
  "devDependencies": {
    "@omgjs/labkit-eslint-config": "0.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3"
  }
}
