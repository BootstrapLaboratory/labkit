{
  "name": "@omgjs/labkit-webapp-graphql-relay",
  "version": "0.1.1",
  "description": "Relay environment, network, route preloading, and store helpers for Labkit webapps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BootstrapLaboratory/labkit.git",
    "directory": "packages/webapp-graphql-relay"
  },
  "homepage": "https://github.com/BootstrapLaboratory/labkit/tree/main/packages/webapp-graphql-relay#readme",
  "bugs": {
    "url": "https://github.com/BootstrapLaboratory/labkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/esm/src/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node ../../common/scripts/write-esm-package-marker.mjs",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run test"
  },
  "dependencies": {
    "@omgjs/labkit-auth-contract": "workspace:*",
    "@omgjs/labkit-webapp-realtime": "workspace:*",
    "graphql-ws": "^6.0.8",
    "react-relay": "^20.1.1",
    "relay-runtime": "^20.1.1"
  },
  "devDependencies": {
    "@omgjs/labkit-eslint-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "eslint": "^10.3.0",
    "react": "^19.2.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^16.9.0 || ^17 || ^18 || ^19"
  }
}
