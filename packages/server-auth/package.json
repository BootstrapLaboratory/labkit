{
  "name": "@omgjs/labkit-server-auth",
  "version": "0.1.1",
  "description": "Server-side auth helpers for Labkit access tokens, guards, sessions, lifecycle events, and refresh transport.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BootstrapLaboratory/labkit.git",
    "directory": "packages/server-auth"
  },
  "homepage": "https://github.com/BootstrapLaboratory/labkit/tree/main/packages/server-auth#readme",
  "bugs": {
    "url": "https://github.com/BootstrapLaboratory/labkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run test"
  },
  "dependencies": {
    "@omgjs/labkit-auth-contract": "0.1.1",
    "@omgjs/labkit-server-graphql": "0.1.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/graphql": "^13.3.0",
    "graphql": "^16.13.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@omgjs/labkit-eslint-config": "0.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3"
  }
}
